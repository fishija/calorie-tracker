FLASK_ENV=development
SECRET_KEY=your_secret_key # generate a real one for production: python -c "import secrets; print(secrets.token_hex(32))"
ANTHROPIC_API_KEY=your_anthropic_api_key

# Postgres database configuration (used in production only)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db
POSTGRES_HOST=db

# Optional: overrides the app's connection string above (POSTGRES_* are still
# required for the db container's own initialization). Useful if connecting to
# an external/managed Postgres instead of the docker-compose db service.
# DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@db/your_postgres_db